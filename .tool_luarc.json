{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "~/.local/share/bob/v0.12.5/share/nvim/runtime"
    ],
    "ignoreDir": [
      ".git",
      ".vscode",
      "deps",
      "docs",
      "node_modules",
      "tests/screenshots"
    ],
    "maxPreload": 10000,
    "preloadFileSize": 2000
  },
  "diagnostics": {
    "libraryFiles": "Disable",
    "workspaceDelay": 0
  },
  "completion": {
    "enable": false
  },
  "hint": {
    "enable": false
  },
  "semantic": {
    "enable": false
  },
  "telemetry": {
    "enable": false
  }
}
