{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "~/.local/share/bob/v0.12.2/share/nvim/runtime",
      "~/.local/share/nvim/lazy/"
    ],
    "ignoreDir": [
      ".vscode",
      ".git",
      "dist",
      "build",
      "node_modules",
      "docs"
    ],
    "maxPreload": 10000
  },
  "completion.enable": false,
  "diagnostics": {
    "libraryFiles": "Disable",
    "workspaceDelay": 0,
    "disable": [
      "missing-fields",
      "incomplete-signature-doc"
    ]
  },
  "hint.enable": false,
  "semantic.enable": false
}
